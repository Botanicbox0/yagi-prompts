# PLAYBOOK — environment (PLAN §7)
# Copy to .env.local for development. Never commit a filled-in copy.

# --- Supabase -----------------------------------------------------------------
# Project settings → API. The anon key is public by design; RLS is deny-all with no policies,
# so the browser client can do nothing but auth.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# SERVER ONLY. lib/supabase/data-client.ts is guarded by `server-only`; never expose this.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Direct Postgres URI — used by `npm run seed` and by migration tooling. Server only.
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# --- App ----------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Local development database -----------------------------------------------
# With no DATABASE_URL, lib/db/connect.ts loads this snapshot into an in-memory PGlite so the
# landing/pricing catalog has real seeded data. Build it with `npm run db:local`.
# PLAYBOOK_LOCAL_DB=.pglite/catalog.tar.gz

# --- Content slots (docs/CONTENT-SLOTS.md) ------------------------------------
# Hero reel, rendered offline with HyperFrames. Unset ⇒ the in-code poster composition renders.
# NEXT_PUBLIC_HERO_REEL_SRC=
# NEXT_PUBLIC_HERO_REEL_TYPE=video/mp4
# NEXT_PUBLIC_HERO_REEL_POSTER=

# --- Media gateway (M2) -------------------------------------------------------
# Signs the ≤60s capability tokens the gateway hands out for private published objects
# (lib/media/token.ts). Unset ⇒ SUPABASE_SERVICE_ROLE_KEY, then a per-process random with a warning.
# Set this in production so tokens survive a restart. Any long random string.
# MEDIA_TOKEN_SECRET=

# --- Storage ------------------------------------------------------------------
# `local` (default) writes under .storage/ — used by dev, the seed and the acceptance tests.
# `supabase` is implemented in a later milestone (lib/storage/supabase-driver.ts).
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=.storage

# --- Stripe (M3) --------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...

# --- Email (M5) ---------------------------------------------------------------
RESEND_API_KEY=re_...
