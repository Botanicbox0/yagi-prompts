        "select r.id::text as root_id, r.ref_key, r.author_id::text as author_id, r.body, r.mentions::text[] as mentions, r.created_at, rp.display_name, rp.email, (select count(*)::int from brand_room_messages x where x.parent_id = r.id and x.deleted_at is null) as reply_count, l.id::text as latest_id, l.author_id::text as latest_author, l.body as latest_body, l.created_at as latest_at, lp.display_name as latest_name, lp.email as latest_email, (r.mentions @> array[$3::uuid] or exists (select 1 from brand_room_messages x where x.parent_id = r.id and x.deleted_at is null and x.mentions @> array[$3::uuid])) as mentioned, tr.last_read_at, ((r.author_id is distinct from $3::uuid and r.created_at > coalesce(tr.last_read_at, '-infinity'::timestamptz)) or exists (select 1 from brand_room_messages x where x.parent_id = r.id and x.deleted_at is null and x.author_id is distinct from $3::uuid and x.created_at > coalesce(tr.last_read_at, '-infinity'::timestamptz))) as unread from brand_room_messages r left join profiles rp on rp.id = r.author_id left join brand_room_thread_reads tr on tr.root_message_id = r.id and tr.user_id = $3::uuid left join lateral ( select z.id, z.author_id, z.body, z.created_at from ( select r.id, r.author_id, r.body, r.created_at union all select x.id, x.author_id, x.body, x.created_at from brand_room_messages x where x.parent_id = r.id and x.deleted_at is null ) z order by z.created_at desc, z.id desc limit 1 ) l on true left join profiles lp on lp.id = l.author_id where r.organization_id = $1 and r.id = any($2::uuid[]) and r.parent_id is null and r.deleted_at is null and r.channel like 'members%'",
