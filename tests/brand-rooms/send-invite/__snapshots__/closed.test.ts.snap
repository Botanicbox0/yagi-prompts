        "update brand_invites set accepted_at=now(),accepted_by=$1 where id=$2",
      ],
      "status": 200,
    },
    {
      "body": {
        "code": "not_found",
        "ok": false,
      },
      "name": "accept the editor’s invitation",
      "statements": [
        "select id,is_admin,email from profiles where id=$1 for update",
        "select * from brand_invites where token_hash=$1",
        "select id from brand_organizations where id=$1 for update",
        "select * from brand_invites where id=$1 for update",
        "select id,is_admin,email from profiles where id=$1 for share",
        "select role from brand_memberships where organization_id=$1 and user_id=$2 and status='active' for share",
      ],
      "status": 404,
    },
    {
      "body": {
        "code": "forbidden",
        "ok": false,
      },
      "name": "accept with another account",
      "statements": [
        "select id,is_admin,email from profiles where id=$1 for update",
        "select * from brand_invites where token_hash=$1",
        "select id from brand_organizations where id=$1 for update",
        "select * from brand_invites where id=$1 for update",
        "select id,is_admin,email from profiles where id=$1 for share",
      ],
      "status": 403,
    },
    {
      "body": {
        "id": "<id11>",
        "ok": true,
      },
      "name": "members page cancel (owner)",
      "statements": [
        "select id,is_admin,email from profiles where id=$1 for update",
        "select id from brand_organizations where id=$1 for update",
        "select role from brand_memberships where organization_id=$1 and user_id=$2 and status='active' for share",
        "update brand_invites set revoked_at=now() where organization_id=$1 and id=$2 and project_id is null and not issued_by_studio and accepted_at is null and revoked_at is null returning id",
      ],
      "status": 200,
    },
  ],
}
`;

