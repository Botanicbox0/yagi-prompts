  "owner state statements": [
    "select id from profiles where id = $1",
    "select id, name from brand_organizations where id = $1",
    "select role from brand_memberships where organization_id = $1 and user_id = $2 and status = 'active'",
    "select id, name from brand_organizations where id = any($1::uuid[])",
    "select denied_features from brand_feature_policies where organization_id = $1",
    "select to_regclass('public.brand_studio_allowances') is not null as allowances, exists ( select 1 from pg_attribute where attrelid = to_regclass('public.brand_studio_allowances') and attname = 'is_override' and not attisdropped ) as override_col, to_regclass('public.brand_plan_assignments') is not null as plans, to_regclass('public.brand_plan_allowance_defaults') is not null as plan_defaults, to_regclass('public.brand_allowance_grants') is not null as grants",
    "select a.monthly_cap_krw as allow_cap_krw, a.preferred_lane as allow_preferred_lane, a.is_override as allow_is_override, p.plan_id as plan_id, p.started_on::text as plan_started_on, p.ends_on::text as plan_ends_on, d.monthly_cap_krw as plan_default_cap_krw, coalesce(( select sum(g.amount_krw) from brand_allowance_grants g where g.organization_id = org.organization_id and g.revoked_at is null and g.valid_month = $2 ), 0)::bigint as extra_krw from (select cast($1 as uuid) as organization_id) org left join brand_studio_allowances a on a.organization_id = org.organization_id left join brand_plan_assignments p on p.organization_id = org.organization_id left join brand_plan_allowance_defaults d on d.plan_id = p.plan_id",
    "select coalesce(sum(ceil(coalesce(usage_krw, estimate_krw) / 10.0) * 10), 0)::bigint as used from brand_studio_jobs where organization_id = $1 and status not in ('failed','canceled') and created_at >= $2 and created_at < $3",
    "select to_regclass($1)::text as t",
    "select to_regclass($1)::text as t",
    "select * from brand_storage_quotas where organization_id = $1",
    "select created_at, studio_managed from brand_organizations where id = $1",
    "select plan_id, started_on::text as started_on, ends_on::text as ends_on from brand_plan_assignments where organization_id = $1",
    "select a.monthly_cap_krw as allow_cap_krw, a.preferred_lane as allow_preferred_lane, a.is_override as allow_is_override, p.plan_id as plan_id, p.started_on::text as plan_started_on, p.ends_on::text as plan_ends_on, d.monthly_cap_krw as plan_default_cap_krw, coalesce(( select sum(g.amount_krw) from brand_allowance_grants g where g.organization_id = org.organization_id and g.revoked_at is null and g.valid_month = $2 ), 0)::bigint as extra_krw from (select cast($1 as uuid) as organization_id) org left join brand_studio_allowances a on a.organization_id = org.organization_id left join brand_plan_assignments p on p.organization_id = org.organization_id left join brand_plan_allowance_defaults d on d.plan_id = p.plan_id",
    "select coalesce(sum(ceil(coalesce(usage_krw, estimate_krw) / 10.0) * 10), 0)::bigint as used from brand_studio_jobs where organization_id = $1 and status not in ('failed','canceled') and created_at >= $2 and created_at < $3",
    "select * from brand_studio_assets where organization_id = $1 and status = 'ready' and deleted_at is null order by created_at desc, id limit $2",
    "select * from brand_studio_jobs where organization_id = $1 and kind in ('image', 'region_edit') and coalesce(params ->> 'purpose', '') <> 'fill' and deleted_at is null order by created_at desc, id limit $2",
    "select * from brand_studio_jobs where organization_id = $1 and kind in ('video', 'video_remix', 'video_final') and model <> 'compose-1080p' and deleted_at is null order by created_at desc, id limit $2",
    "select id, title from brand_projects where organization_id = $1 and client_visible and status not in ('completed','cancelled') order by updated_at desc limit 50",
    "select * from brand_studio_outputs where job_id = any($1::uuid[]) order by job_id, idx",
  ],
